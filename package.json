{
  "name": "maxauth-migration-tool",
  "version": "1.0.2",
  "description": "Portable migration tool for jPremium and MaxAuth BETA authentication data",
  "desktopName": "MaxAuth Migration Tool",
  "main": "main.js",
  "author": "DJDevs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz --x64 --publish never",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "eu.djdevs.maxauth.migration",
    "productName": "MaxAuth Migration Tool",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MaxAuth-Migration-Tool-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "MaxAuth-Migration-Tool-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "maintainer": "DJDevs <djnejk@djdevs.eu>",
      "executableName": "maxauth-migration-tool",
      "artifactName": "MaxAuth-Migration-Tool-${version}-linux-${arch}.${ext}",
      "synopsis": "Migrate jPremium and MaxAuth BETA authentication data",
      "description": "Portable migration tool for converting jPremium and MaxAuth BETA authentication data to MaxAuth 1.0.0 and newer."
    }
  }
}
